{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)9540143b-a0c1-4a26-b7d6-821ef910b457","ParentGuid":"(Guid)00000000-0000-0000-0000-000000000000","Name":"(string)FB_ASCIIoverUDPpeer_SE","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)21af5390-2942-461a-bf89-951aaf6999f1","@Value":"(Guid)8fffdb19-5897-43b7-85fc-3378c11e523f"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)(* Get the status of the UDP Peer *)\nxReadyToWrite\t\t\t:= fbUdpPeer.IsWritable;\nxDataToRead\t\t\t\t:= fbUdpPeer.IsReadable;\nudiBytesAvailableToRead\t:= fbUdpPeer.BytesAvailableToRead;\netUdpPeerState\t\t\t:= fbUdpPeer.State;\n\n(* Check the Ethernet Status of the controller *)\nIF NOT i_xEnable THEN\n\tiState\t\t\t:= 0;\t// stay in Idle\nELSIF NOT i_xEthIfReady THEN\n\txInterruptEth\t:= xPortOpen;\n\txPortOpen\t\t:= FALSE;\t// reset the status flag\n\tiState\t\t\t:= 100;\t// go into state 100 - do nothing\nELSE\n\tIF (iState = 100) THEN\n\t\tIF (fbUdpPeer.State <> TCPUDP.ET_State.Idle) THEN\n\t\t\tiState\t:= 50;\n\t\tELSE\n\t\t\tiState\t:= 0;\n\t\tEND_IF\n\tEND_IF\n\txInterruptEth\t:= FALSE;\nEND_IF\n\n(* Function block inputs *)\n(* Monitor rising edges of commands *)\nfbRTrigOpenAndBind\t(CLK:= i_xCmdOpenBind);\nfbRTrigClose\t\t(CLK:= i_xCmdClose);\nfbRTrigClearResult\t(CLK:= i_xCmdClearResult);\nsIpAddrLocal\t\t:= i_sIpAddrLocal;\nuiUdpPortLocal\t\t:= i_uiUdpPortLocal;\n\n(* Clear the result *)\nIF (fbRTrigClearResult.Q OR (fbRTrigOpenAndBind.Q AND iState = 0) OR NOT i_xEnable) THEN\n\t// reset all alarms and warnings\n\txAlarmBind\t\t\t\t:= FALSE;\n\txAlarmOpen\t\t\t\t:= FALSE;\n\txAlarmSend\t\t\t\t:= FALSE;\n\txAlarmReceive\t\t\t:= FALSE;\n\txAlarmClose\t\t\t\t:= FALSE;\n\txUnexpectedData\t\t\t:= FALSE;\n\t\n\tfbUdpPeer.ResetResult();\n\tetUdpPeerResult\t\t\t:= TCPUDP.ET_Result.Ok;\n\tsStepFailed\t\t\t\t:='';\n\tIF xCloseAfterFailedBind THEN\n\t\tA_Close();\n\t\txCloseAfterFailedBind\t:= FALSE;\n\t\tetUdpPeerState\t\t\t:= fbUdpPeer.State;\n\tEND_IF\nEND_IF\n\nIF fbRTrigClose.Q THEN\t// request to close the port\n\tiState\t:= 50;\nEND_IF\n\n// Only one message is read per cycle. No new message is read until the previous one has been processed outside this FB (iq_stPeerInfo.xDataReceived reset to FALSE)\n\nCASE iState OF\n\t0:\t(* Bind an UDP port to a dedicated interface *)\n\t\tIF i_xEnable AND fbRTrigOpenAndBind.Q THEN\n\t\t\tA_OpenAndBindLocalPort();\n\t\tEND_IF\n\t\t\n\t10:\t(* Wait for request to send data (push), monitor if data have been received *)\n\t\tIF iq_stPeerInfo.xPushData AND xReadyToWrite THEN\n\t\t\t// send the prepared data to the UDP peer which sent the last data received\n\t\t\tsIpAddrPeer\t\t\t:= iq_stPeerInfo.sIp;\n\t\t\tuiUdpPortPeer\t\t:= iq_stPeerInfo.uiPort;\n\t\t\tstDataSend.sData\t:= iq_stPeerInfo.stDataToSend.sData;\n\t\t\tA_SendData();\n\t\t\t// reset the push data request flag\n\t\t\tiq_stPeerInfo.xPushData\t:= FALSE;\n\t\tELSIF xDataToRead AND NOT iq_stPeerInfo.xDataReceived AND NOT iq_stPeerInfo.xPushData THEN\n\t\t\tA_ReceiveData();\n\t\t\tIF xDataReceivedDone AND NOT xUnexpectedData THEN\n\t\t\t\t// make the data received available outside this FB\n\t\t\t\tiq_stPeerInfo.sIp\t\t\t\t\t:= sIpAddrSender;\n\t\t\t\tiq_stPeerInfo.uiPort\t\t\t\t:= uiUdpPortSender;\n\t\t\t\tiq_stPeerInfo.stDataReceived.sData\t:= stDataReceive.sData;\n\t\t\t\tiq_stPeerInfo.xDataReceived\t\t\t:= TRUE;\n\t\t\tEND_IF\n\t\tEND_IF\n\n\t50:\t(* Close the port *)\n\t\tA_Close();\n\t\n\t100:(* Ethernet Interface of the controller not ready *)\n\t\t;\t// do nothing\n\t\nEND_CASE\n\n(* Create diagnostic message *)\nIF NOT i_xEnable THEN\t\t\n\tsDiagMessage\t:= 'Udp Peer disabled';\n\txDiag\t\t\t:= FALSE;\t\nELSIF (iState = 100) THEN\t\t\n\tsDiagMessage\t:= 'Ethernet link not ready';\n\txDiag\t\t\t:= TRUE;\t\nELSIF xAlarmBind THEN\t\t\n\tsDiagMessage\t:= 'Bind a local port failed';\n\txDiag\t\t\t:= TRUE;\nELSIF xAlarmOpen THEN\t\t\n\tsDiagMessage\t:= 'Open the UDP socket failed';\n\txDiag\t\t\t:= TRUE;\nELSIF xAlarmSend THEN\t\t\n\tsDiagMessage\t:= 'Send data failed';\n\txDiag\t\t\t:= TRUE;\nELSIF xAlarmReceive THEN\t\t\n\tsDiagMessage\t:= 'Receive data failed';\n\txDiag\t\t\t:= TRUE;\nELSIF xAlarmClose THEN\t\t\n\tsDiagMessage\t:= 'Close UDP socket failed';\n\txDiag\t\t\t:= TRUE;\nELSIF xUnexpectedData THEN\t\t\n\tsDiagMessage\t:= 'Unexpected data from UDP peer. Reception buffer full. Data discarded';\n\txDiag\t\t\t:= TRUE;\nELSE\t\t\t\n\tsDiagMessage\t:= 'No alarm or warning';\n\txDiag\t\t\t:= FALSE;\nEND_IF\nIF xDiag THEN\n\tq_sLastErrorDiagMessage := sDiagMessage;\nEND_IF\n\n(* Function block outputs *)\nq_sUdpPeerState\t\t:= TCPUDP.FC_EtStateToString(i_etState:= etUdpPeerState);\nq_sUdpPeerResult\t:= Standard.CONCAT(sStepFailed, TCPUDP.FC_EtResultToString(i_etResult:= etUdpPeerResult));\nq_xDiag\t\t\t\t:= xDiag;\nq_sDiagMessage\t\t:= sDiagMessage;\nq_xPortOpen\t\t\t:= xPortOpen;","LineInfoPersistence":"(string)9540143b-a0c1-4a26-b7d6-821ef910b457_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_ASCIIoverUDPpeer_SE\nVAR_INPUT\n\t/// Enable FB operation\n\ti_xEnable: BOOL;\n\t/// Ethernet interface ready\n\ti_xEthIfReady: BOOL;\n\t/// Open a socket and bind the local port on rising edge\n\ti_xCmdOpenBind: BOOL;\n\t/// Close the socket on rising edge\n\ti_xCmdClose: BOOL;\n\t/// Clear last diagnostic messages and alarms on rising edge\n\ti_xCmdClearResult: BOOL;\n\t/// IP address of the Eth interface where to listen, '0.0.0.0' to listen on all interfaces\n\ti_sIpAddrLocal: STRING(15);\n\t/// UDP port for incoming data\n\ti_uiUdpPortLocal: UINT;\nEND_VAR\nVAR_OUTPUT\n\t/// Socket status. When TRUE the socket is open and the local port is bound\n\tq_xPortOpen: BOOL;\n\t/// UDP peer diagnostic message\n\tq_sDiagMessage: STRING;\n\t/// When TRUE, an alarm is active and a diagnostic message is available\n\tq_xDiag: BOOL;\n\t/// UDP peer current state. Refer to ENUM ET_State in Schneider's TCPUDP library\n\tq_sUdpPeerState: STRING;\n\t/// UDP peer result of last transaction. Refer to ENUM ET_Result in Schneider's TCPUDP library\n\tq_sUdpPeerResult: STRING;\n\t/// Last registered diagnostic message\n\tq_sLastErrorDiagMessage: STRING;\nEND_VAR\nVAR_IN_OUT\n\t/// UDP peer information: sender of the last data received and data exchange information\n\tiq_stPeerInfo: ST_UdpPeerInfo_SE;\nEND_VAR\nVAR\n\tfbUdpPeer:TCPUDP.FB_UDPPeer;\n\tsIpAddrLocal\t\t:STRING(15);\t\t// IP address of the Eth interface where to listen, '0.0.0.0' to listen on all interfaces\n\tuiUdpPortLocal\t\t:UINT;\t\t\t\t// UDP Port for incomming data \n\tsIpAddrPeer\t\t\t:STRING(15);\t\t// IP address of the UDP peer to which the data shall be sent\n\tuiUdpPortPeer\t\t:UINT;\t\t\t\t// UDP port of the peer to which the data shall be sent\n\tsIpAddrSender\t\t:STRING(15);\t\t// IP address of the UDP peer which sent the data\n\tuiUdpPortSender\t\t:UINT;\t\t\t\t// UDP Port of the UDP peer which sent the data\n\t\n\t(* State variable *)\n\txInterruptEth\t\t\t:BOOL;\t\t\t\t\t// indicates the Ethernet was disturbed, while the TCP port was open\n\tetUdpPeerState\t\t\t:TCPUDP.ET_State;\t\t// state of the TCP connection\n\tetUdpPeerResult\t\t\t:TCPUDP.ET_Result;\t\t// result of the latest method call\n\txPortOpen\t\t\t\t:BOOL;\n\txBindDone\t\t\t\t:BOOL;\n\txOpenDone\t\t\t\t:BOOL;\n\txCloseDone\t\t\t\t:BOOL;\n\tudiBytesAvailableToRead\t:UDINT;\t\t\t\t\t// indicates the number of bytes available to read in the buffer\n\txDataToRead\t\t\t\t:BOOL;\t\t\t\t\t// indicates that data are available to read\n\txReadyToWrite\t\t\t:BOOL;\t\t\t\t\t// indicates that the socket is ready for sending data\n\txDataReceivedDone\t\t:BOOL;\n\txCloseAfterFailedBind\t:BOOL;\t\t\t\t\t// Indicates a Bind command failed, and a call of the method Close must be executed\n\t\t\n\tiState\t\t\t\t:INT;\t\t\t\t\t\t// current state of the staemachine\n\t\n\tstDataSend, stDataReceive\t:ST_UdpPeerData_SE;\n\tabySendBuffer\t\t\t:ARRAY [0..SIZEOF(stDataSend)-1] OF BYTE;\t\t// send buffer\n\tabyReceiveBuffer\t\t:ARRAY [0..SIZEOF(stDataReceive)-1] OF BYTE;\t// receive buffer\n\t\n\tudiReceiveBufferSize\t:UDINT;\t\t// max number of Bytes to be read using the Receive method, !!! Must not be greater than the Buffer size! !!!\n\tudiFillLevelSend\t\t:UDINT;\t\t// fill level of the send buffer\n\tudiSizeReceivedData\t\t:UDINT;\t\t// Number of bytes read from the buffer using the method Receive\n\tudiSentData\t\t\t\t:UDINT;\t\t// Number of bytes sent to the server using the method Send\n\t\n\tfbRTrigOpenAndBind, fbRTrigClose, fbRTrigClearResult\t:Standard.R_TRIG;\n\t\n\t\n\t(* Alarms and Warnings *)\n\txAlarmBind\t\t\t\t:BOOL;\t\t\t\t\t// Alarm: Bind failed\n\txAlarmOpen\t\t\t\t:BOOL;\t\t\t\t\t// Alarm: Open failed\n\txAlarmSend\t\t\t\t:BOOL;\t\t\t\t\t// Alarm: not all bytes have been sent\n\txAlarmReceive\t\t\t:BOOL;\t\t\t\t\t// Alarm: Receive method\n\txAlarmClose\t\t\t\t:BOOL;\t\t\t\t\t// Alarm: Close the port failed\n\txUnexpectedData\t\t\t:BOOL;\t\t\t\t\t// Warning: Data received fills the receive buffer (datagram too big). Data discarded\n\txDiag\t\t\t\t\t:BOOL;\t\t\t\t\t// Indicates a Diag message is available\n\tsDiagMessage\t\t\t:STRING;\t\t\t\t// Diag message created from the alarms and warnings\n\tsStepFailed\t\t\t\t:STRING;\t\t\t\t// String contains the name of the Step or Method which is failed to precise the result message\nEND_VAR","LineInfoPersistence":"(string)9540143b-a0c1-4a26-b7d6-821ef910b457_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)654","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}