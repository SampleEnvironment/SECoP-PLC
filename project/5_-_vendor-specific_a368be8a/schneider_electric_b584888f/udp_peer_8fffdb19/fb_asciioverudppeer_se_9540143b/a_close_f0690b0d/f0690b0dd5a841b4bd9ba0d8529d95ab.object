{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)f0690b0d-d5a8-41b4-bd9b-a0d8529d95ab","ParentGuid":"(Guid)9540143b-a0c1-4a26-b7d6-821ef910b457","Name":"(string)A_Close","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// close the port\nxCloseDone\t:= fbUdpPeer.Close();\nIF xCloseDone THEN\n\tiState\t\t:= 0;\t// go to initiate the Listening\n\txAlarmClose\t:= FALSE;\n\txPortOpen\t:= FALSE;\nELSE\n\tetUdpPeerResult\t:= fbUdpPeer.Result;\t// connection failed, check the result\n\tsStepFailed\t\t:= 'Close: ';\n\txAlarmClose\t\t:= TRUE;\nEND_IF","LineInfoPersistence":"(string)f0690b0d-d5a8-41b4-bd9b-a0d8529d95ab_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)12"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}