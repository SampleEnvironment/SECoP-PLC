{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)dd689d3c-769f-4ca7-80d8-a8f302db668a","ParentGuid":"(Guid)9540143b-a0c1-4a26-b7d6-821ef910b457","Name":"(string)A_OpenAndBindLocalPort","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)(* Open a socket and bind the port *)\n// binding a port is necessary for receiving data and if you want to use a specified port, for sending data from any port \"Open\" only is sufficient\nIF etUdpPeerState = TCPUDP.ET_State.Idle THEN\n\txAlarmOpen\t\t\t:= FALSE;\n\t(* Open the Socket *)\n\txOpenDone\t:= fbUdpPeer.Open();\n\tIF NOT xOpenDone THEN\n\t\tetUdpPeerResult\t\t:= fbUdpPeer.Result;\t// connection failed, check the result\n\t\tsStepFailed\t\t\t:= 'Open: ';\n\t\txAlarmOpen\t\t\t:= TRUE;\n\tEND_IF\nEND_IF\nIF (etUdpPeerState = TCPUDP.ET_State.Opened) OR xOpenDone THEN\n\t// Socket is open\t\n\t(* Bind a port *)\n\txBindDone\t:= fbUdpPeer.Bind(\ti_sLocalIP\t\t:= sIpAddrLocal,\n\t\t\t\t\t\t\t\t\ti_uiLocalPort\t:= uiUdpPortLocal);\n\tIF NOT xBindDone THEN\n\t\tetUdpPeerResult\t\t\t:= fbUdpPeer.Result;\t// connection failed, check the result\n\t\tsStepFailed\t\t\t\t:= 'Bind: ';\n\t\txAlarmBind\t\t\t\t:= TRUE;\n\t\txCloseAfterFailedBind\t:= TRUE;\n\tELSE\n\t\t// port is bound and open\n\t\tiState\t\t\t\t:= 10;\t// wait for incoming connection\n\t\txPortOpen\t\t\t:= TRUE;\n\t\txAlarmOpen\t\t\t:= FALSE;\n\t\txAlarmBind\t\t\t:= FALSE;\n\tEND_IF\nEND_IF\n","LineInfoPersistence":"(string)dd689d3c-769f-4ca7-80d8-a8f302db668a_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)81"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}