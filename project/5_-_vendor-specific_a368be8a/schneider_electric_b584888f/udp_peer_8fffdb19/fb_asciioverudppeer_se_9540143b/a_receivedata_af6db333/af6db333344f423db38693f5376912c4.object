{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)af6db333-344f-423d-b386-93f5376912c4","ParentGuid":"(Guid)9540143b-a0c1-4a26-b7d6-821ef910b457","Name":"(string)A_ReceiveData","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// set the data to be read from the buffer (one byte kept for the string terminator), NOTE: 2048 bytes is the limitation for M241 & M251 controllers\nudiReceiveBufferSize\t:= LIMIT(1, MIN(SIZEOF(abyReceiveBuffer) - 1, (udiBytesAvailableToRead)), GPL_UdpPeer_SE.Gc_uiDataSize);\n\n// Initialize the receive buffer\nSysMem.SysMemSet(pDest:= ADR(abyReceiveBuffer), udiValue:= 0, udiCount:= SIZEOF(abyReceiveBuffer));\nxUnexpectedData := FALSE;\n\n// take the data from the buffer using the Receive method\nudiSizeReceivedData\t:= fbUdpPeer.ReceiveFrom(\ti_pbyReceiveBuffer\t\t:= ADR(abyReceiveBuffer),\n\t\t\t\t\t\t\t\t\t\t\t\ti_udiReceiveBufferSize\t:= udiReceiveBufferSize,\n\t\t\t\t\t\t\t\t\t\t\t\tq_xDataReceived\t\t\t=> xDataReceivedDone,\n\t\t\t\t\t\t\t\t\t\t\t\tq_sPeerIP\t\t\t\t=> sIpAddrSender,\n\t\t\t\t\t\t\t\t\t\t\t\tq_uiPeerPort\t\t\t=> uiUdpPortSender);\n\t\t\nIF NOT xDataReceivedDone THEN\n\tetUdpPeerResult\t:= fbUdpPeer.Result;\t// Peek failed, check the result\n\tsStepFailed\t\t:= 'Receive: ';\n\txAlarmReceive\t:= TRUE;\t\t\t\nELSIF udiSizeReceivedData >= (SIZEOF(abyReceiveBuffer) - 1) THEN\n\t// received data must be less than the receive buffer size (datagram too big): data discarded\n\txUnexpectedData := TRUE;\nELSE\n// convert the data to string (data only, no header)\nTCPUDP.FC_ReadSTRING(\ti_pbyBuffer\t\t:= ADR(abyReceiveBuffer[0]),\n\t\t\t\t\t\ti_psString\t\t:= ADR(stDataReceive.sData),\n\t\t\t\t\t\ti_uiMaxLength\t:= SIZEOF(stDataReceive.sData)-1,\n\t\t\t\t\t\ti_xStopAtZero\t:= TRUE);\nEND_IF","LineInfoPersistence":"(string)af6db333-344f-423d-b386-93f5376912c4_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)111"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}