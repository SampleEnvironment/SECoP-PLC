{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)fd3cd7f3-2628-4ce2-ae08-bccc326edb94","ParentGuid":"(Guid)00000000-0000-0000-0000-000000000000","Name":"(string)ST_UdpPeerInfo_SE","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)21af5390-2942-461a-bf89-951aaf6999f1","@Value":"(Guid)8fffdb19-5897-43b7-85fc-3378c11e523f"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)TYPE ST_UdpPeerInfo_SE :\nSTRUCT\n\t/// IP address of the UDP peer which sent the last data received. Data to send (push) is sent to this IP address\n\tsIp: STRING(15);\n\t/// UDP port of the UDP peer which sent the last data received. Data to send (push) is sent to this port\n\tuiPort: UINT;\n\t/// Data received from the UDP peer\n\tstDataReceived: ST_UdpPeerData_SE;\n\t/// Data to send to the UDP peer (to be prepared outside the UDP peer FB)\n\tstDataToSend: ST_UdpPeerData_SE;\n\t/// Flag set to TRUE by the FB when new data has been received. To be reset to FALSE outside this FB once the data is processed. No new data is read while TRUE\n\txDataReceived: BOOL;\n\t/// Flag set to TRUE outside this FB for requesting the prepared data to be sent. The FB resets it to FALSE as soon as the data is sent\n\txPushData: BOOL;\nEND_STRUCT\nEND_TYPE","LineInfoPersistence":"(string)fd3cd7f3-2628-4ce2-ae08-bccc326edb94_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)61"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}